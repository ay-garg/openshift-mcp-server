# ─────────────────────────────────────────────────────────
# OpenShift MCP Server — environment configuration
# Copy to .env and fill in values.
# ─────────────────────────────────────────────────────────

# ── Single-cluster: Service Account token ──────────────────
# OCP_API_URL=https://api.mycluster.example.com:6443
# OCP_TOKEN=sha256~xxxxxx
# OCP_SKIP_TLS_VERIFY=false   # set true only for self-signed dev certs (k8s API)

# ── Single-cluster: username / password ────────────────────
# OCP_API_URL=https://api.mycluster.example.com:6443
# OCP_USERNAME=kubeadmin
# OCP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Single-cluster: kubeconfig (default) ───────────────────
# Uses ~/.kube/config if none of the above are set.
# OCP_KUBECONFIG=/home/user/.kube/config
# OCP_KUBECONFIG_CONTEXT=my-cluster-context

# ── Multi-cluster ───────────────────────────────────────────
# JSON array of cluster config objects.
# Supported fields: name, api_url, token, username, password, skip_tls_verify
# OCP_CLUSTERS='[{"name":"prod","api_url":"https://api.prod.example.com:6443","token":"sha256~prod..."},{"name":"staging","api_url":"https://api.staging.example.com:6443","token":"sha256~staging...","skip_tls_verify":true}]'

# ── Prometheus / Alertmanager ───────────────────────────────
# Auto-detected from thanos-querier when not set.
# OCP_PROMETHEUS_URL=https://thanos-querier.openshift-monitoring.svc:9091
# OCP_ALERTMANAGER_URL=https://alertmanager-main.openshift-monitoring.svc:9093
# OCP_PROMETHEUS_TOKEN=<token>   # defaults to OCP_TOKEN
# OCP_VERIFY_SSL=false           # set false to skip TLS for Prometheus/Alertmanager HTTP calls

# ── Transport ───────────────────────────────────────────────
# MCP_TRANSPORT=stdio            # stdio (default) or sse
# MCP_HOST=127.0.0.1             # default; set to 0.0.0.0 for external SSE access
# MCP_PORT=8080

# ── Gradio Web UI ────────────────────────────────────────────
# GRADIO_HOST=0.0.0.0
# GRADIO_PORT=7860
# GRADIO_SHARE=false             # set true to get a public Gradio URL

# ── AI Chat (Gradio UI Tab 2) ────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
